/* 
 * 属性フォーム用スタイルシート
 * 
 * 読みやすく、入力しやすいフォームUIを実現する
 */

/* タブウィジェット */
QTabWidget::pane {
    border: 1px solid #c0c0c0;
    border-radius: 4px;
    background-color: #ffffff;
}

QTabBar::tab {
    background-color: #e0e0e0;
    border: 1px solid #c0c0c0;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    padding: 8px 16px;
    margin-right: 2px;
    font-size: 11pt;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    border-bottom: 1px solid #ffffff;
    font-weight: bold;
}

QTabBar::tab:hover {
    background-color: #f0f0f0;
}

/* ラベル */
QLabel {
    font-size: 10pt;
    color: #333333;
}

/* 入力フィールド */
QLineEdit {
    border: 1px solid #c0c0c0;
    border-radius: 3px;
    padding: 6px;
    background-color: #ffffff;
    font-size: 10pt;
}

QLineEdit:focus {
    border: 2px solid #0078d4;
    background-color: #f8fcff;
}

QLineEdit:read-only {
    background-color: #f5f5f5;
    color: #666666;
}

/* テキストエリア */
QTextEdit {
    border: 1px solid #c0c0c0;
    border-radius: 3px;
    padding: 6px;
    background-color: #ffffff;
    font-size: 10pt;
}

QTextEdit:focus {
    border: 2px solid #0078d4;
    background-color: #f8fcff;
}

/* コンボボックス */
QComboBox {
    border: 1px solid #c0c0c0;
    border-radius: 3px;
    padding: 6px;
    background-color: #ffffff;
    font-size: 10pt;
}

QComboBox:focus {
    border: 2px solid #0078d4;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 6px solid #666666;
    margin-right: 6px;
}

/* 日付ピッカー */
QDateEdit {
    border: 1px solid #c0c0c0;
    border-radius: 3px;
    padding: 6px;
    background-color: #ffffff;
    font-size: 10pt;
}

QDateEdit:focus {
    border: 2px solid #0078d4;
}

/* ボタン */
QPushButton {
    background-color: #0078d4;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 8px 16px;
    font-size: 10pt;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #006cc1;
}

QPushButton:pressed {
    background-color: #005a9e;
}

QPushButton:disabled {
    background-color: #cccccc;
    color: #888888;
}

/* キャンセルボタン */
QPushButton[text="キャンセル"] {
    background-color: #e0e0e0;
    color: #333333;
}

QPushButton[text="キャンセル"]:hover {
    background-color: #d0d0d0;
}

/* グループボックス */
QGroupBox {
    border: 1px solid #c0c0c0;
    border-radius: 4px;
    margin-top: 12px;
    padding-top: 12px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    background-color: #ffffff;
}

/* スクロールバー */
QScrollBar:vertical {
    border: none;
    background-color: #f0f0f0;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #c0c0c0;
    border-radius: 6px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #a0a0a0;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}
